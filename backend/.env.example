# ==============================================================================
# StudyMate AI - Backend Environment Configuration Example
# ==============================================================================
# HƯỚNG DẪN:
# 1. Tạo bản sao của file này và đổi tên thành '.env' trong thư mục backend/
#    (Lệnh: cp .env.example .env hoặc copy thủ công trên Windows).
# 2. TUYỆT ĐỐI KHÔNG commit file '.env' lên GitHub.
# 3. Điền API Key và tạo mã JWT Secret an toàn theo hướng dẫn bên dưới.
# ==============================================================================

# Cổng khởi chạy của máy chủ Express Backend
PORT=5000

# Môi trường chạy (development | production | test)
NODE_ENV=development

# URL của Frontend để cấu hình CORS (cho phép React truy cập API)
CLIENT_URL=http://localhost:5173

# Đường dẫn file SQLite Database (tương đối từ thư mục backend)
DB_PATH=./data/studymate.db

# ------------------------------------------------------------------------------
# CẤU HÌNH XÁC THỰC JWT (JSON Web Token)
# ------------------------------------------------------------------------------
# CẢNH BÁO: 'YOUR_JWT_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION' CHỈ LÀ GIÁ TRỊ MẪU!
# ĐỂ TẠO MỘT SECRET AN TOÀN CHO FILE .env CỦA BẠN, HÃY CHẠY LỆNH SAU TRONG TERMINAL:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Sau đó copy chuỗi hex ngẫu nhiên vừa tạo và dán vào biến JWT_SECRET trong file .env.
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION

# Thời gian hết hạn của Access Token (ví dụ: 24h, 2h, 7d)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API KEY
# ------------------------------------------------------------------------------
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# Lưu ý: API Key chỉ được gọi tại Backend, không bao giờ để lộ ở Frontend!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
